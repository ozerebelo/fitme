# ---------------------------------------------------------------------------
# FitMe environment
#
# Everything except the two Anthropic-backed features works with none of these
# set. Copy to .env.local for development; set them in your host's dashboard for
# production.
# ---------------------------------------------------------------------------

# Required for photo meal logging, conversational logging, and coach Q&A.
# Without it those three show a clear message and the rest of the app is
# unaffected — all coaching insights are computed locally.
ANTHROPIC_API_KEY=

# Effort used when parsing a typed meal description. "low" is fast and correct
# for ordinary sentences; raise to "medium" if you routinely describe complex
# home-cooked meals. Photo analysis is fixed at "medium" — portion estimation
# from an image is the harder judgement.
# FITME_PARSE_EFFORT=low

# Open Food Facts identifies callers by User-Agent. Set this to something that
# names your deployment; it is good manners and they ask for it.
# OPENFOODFACTS_USER_AGENT=FitMe/0.1 (you@example.com)

# Point barcode and branded-food lookup at a mirror, or at a stub in tests.
# OPENFOODFACTS_BASE_URL=https://world.openfoodfacts.org
